	</map>

	<map context="VavooListActions">
		<key id="KEY_FAVORITES" mapto="favourites" flags="m" />
		<key id="KEY_FAVORITES" mapto="ignore" flags="brl" />
		<key id="KEY_PVR" mapto="recordings" flags="m" />
		<key id="KEY_PVR" mapto="ignore" flags="brl" />
		<key id="KEY_FILE" mapto="recordings" flags="m" />
		<key id="KEY_FILE" mapto="ignore" flags="brl" />
		<key id="KEY_VIDEO" mapto="recordings" flags="m" />
		<key id="KEY_VIDEO" mapto="ignore" flags="brl" />
		<key id="KEY_LIST" mapto="recordings" flags="m" />
		<key id="KEY_LIST" mapto="ignore" flags="brl" />
		<key id="KEY_TEXT" mapto="search" flags="m" />
		<key id="KEY_TEXT" mapto="ignore" flags="brl" />
		<key id="KEY_HELP" mapto="help" flags="m" />
		<key id="KEY_HELP" mapto="ignore" flags="brl" />
		<key id="KEY_PLAY" mapto="play" flags="m" />
		<key id="KEY_PLAY" mapto="ignore" flags="brl" />
		<key id="KEY_PLAYPAUSE" mapto="play" flags="m" />
		<key id="KEY_PLAYPAUSE" mapto="ignore" flags="brl" />
		<key id="KEY_STOP" mapto="stop" flags="m" />
