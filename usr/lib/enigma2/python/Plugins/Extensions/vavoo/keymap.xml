		<key id="KEY_BACK" mapto="back" flags="m" />
		<key id="KEY_BACK" mapto="ignore" flags="brl" />
	</map>

	<!-- the main list's EPG (the favourites' guide): OpenPLi names EPG
	     "info" there, which the main list keeps for its info note -->
	<map context="VavooMainActions">
		<key id="KEY_EPG" mapto="epg" flags="m" />
		<key id="KEY_EPG" mapto="ignore" flags="brl" />
	</map>
</keymap>
