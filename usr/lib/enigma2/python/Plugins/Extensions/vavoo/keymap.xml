		<key id="KEY_0" mapto="0" flags="m" />
		<key id="KEY_0" mapto="ignore" flags="brl" />
		<key id="KEY_1" mapto="1" flags="m" />
		<key id="KEY_1" mapto="ignore" flags="brl" />
		<key id="KEY_2" mapto="2" flags="m" />
		<key id="KEY_2" mapto="ignore" flags="brl" />
		<key id="KEY_3" mapto="3" flags="m" />
		<key id="KEY_3" mapto="ignore" flags="brl" />
		<key id="KEY_4" mapto="4" flags="m" />
