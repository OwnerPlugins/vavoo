<!--
	The plugin's own keys, loaded by plugin.py (load_keymap()) so that a key
	means the same in the player on every image (OpenATV, OpenPLi, OpenViX,
	DreamOS...), whatever the image's own keymap.xml calls it there - OpenATV
	7 renamed MENU's action to "showMenu", OpenPLi's PLAY only resumes, and
	Enigma2 turns its pause/seek keys off for a stream it cannot seek (live).

	One action per key, on the press ("m"); the key's other events (release,
	repeat, hold) go to "ignore", so no Enigma2 handler below the player's
	own (main menu, seek, arrow seek, audio menu on YELLOW...) acts on them.
	Only the flags m, b, r and l: older images know no other.
	plugin.py's PLAYER_KEYS screens (Playstream2, VavooRecordingPlayer) map
	these names; a key a screen does not map falls through to Enigma2.
-->
<keymap>
	<map context="VavooPlayerActions">
		<key id="KEY_OK" mapto="ok" flags="m" />
		<key id="KEY_OK" mapto="ignore" flags="brl" />
		<key id="KEY_EXIT" mapto="exit" flags="m" />
		<key id="KEY_EXIT" mapto="ignore" flags="brl" />
		<key id="KEY_BACK" mapto="exit" flags="m" />
		<key id="KEY_BACK" mapto="ignore" flags="brl" />
		<key id="KEY_STOP" mapto="stop" flags="m" />
		<key id="KEY_STOP" mapto="ignore" flags="brl" />

		<key id="KEY_UP" mapto="up" flags="mr" />
		<key id="KEY_UP" mapto="ignore" flags="bl" />
		<key id="KEY_DOWN" mapto="down" flags="mr" />
		<key id="KEY_DOWN" mapto="ignore" flags="bl" />
		<key id="KEY_LEFT" mapto="left" flags="mr" />
		<key id="KEY_LEFT" mapto="ignore" flags="bl" />
		<key id="KEY_RIGHT" mapto="right" flags="mr" />
		<key id="KEY_RIGHT" mapto="ignore" flags="bl" />
		<key id="KEY_CHANNELUP" mapto="channelUp" flags="m" />
		<key id="KEY_CHANNELUP" mapto="ignore" flags="brl" />
		<key id="KEY_CHANNELDOWN" mapto="channelDown" flags="m" />
		<key id="KEY_CHANNELDOWN" mapto="ignore" flags="brl" />

		<key id="KEY_RED" mapto="red" flags="m" />
		<key id="KEY_RED" mapto="ignore" flags="brl" />
		<key id="KEY_GREEN" mapto="green" flags="m" />
		<key id="KEY_GREEN" mapto="ignore" flags="brl" />
		<key id="KEY_YELLOW" mapto="yellow" flags="m" />
		<key id="KEY_YELLOW" mapto="ignore" flags="brl" />
		<key id="KEY_BLUE" mapto="blue" flags="m" />
		<key id="KEY_BLUE" mapto="ignore" flags="brl" />

		<key id="KEY_MENU" mapto="menu" flags="m" />
		<key id="KEY_MENU" mapto="ignore" flags="brl" />
		<key id="KEY_INFO" mapto="info" flags="m" />
		<key id="KEY_INFO" mapto="ignore" flags="brl" />
		<key id="KEY_EPG" mapto="epg" flags="m" />
		<key id="KEY_EPG" mapto="ignore" flags="brl" />
		<key id="KEY_AUDIO" mapto="audio" flags="m" />
		<key id="KEY_AUDIO" mapto="ignore" flags="brl" />
		<key id="KEY_SUBTITLE" mapto="subtitle" flags="m" />
		<key id="KEY_SUBTITLE" mapto="ignore" flags="brl" />
		<key id="KEY_RECORD" mapto="record" flags="m" />
		<key id="KEY_RECORD" mapto="ignore" flags="brl" />

		<key id="KEY_PLAY" mapto="playpause" flags="m" />
		<key id="KEY_PLAY" mapto="ignore" flags="brl" />
		<key id="KEY_PAUSE" mapto="playpause" flags="m" />
		<key id="KEY_PAUSE" mapto="ignore" flags="brl" />
		<key id="KEY_PLAYPAUSE" mapto="playpause" flags="m" />
		<key id="KEY_PLAYPAUSE" mapto="ignore" flags="brl" />
		<key id="KEY_FASTFORWARD" mapto="forward" flags="m" />
		<key id="KEY_FASTFORWARD" mapto="ignore" flags="brl" />
		<key id="KEY_REWIND" mapto="rewind" flags="m" />
		<key id="KEY_REWIND" mapto="ignore" flags="brl" />

		<key id="KEY_0" mapto="0" flags="m" />
		<key id="KEY_0" mapto="ignore" flags="brl" />
		<key id="KEY_1" mapto="1" flags="m" />
