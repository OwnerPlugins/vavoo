#!/bin/sh

# Vavoo Stream Live - Preinstallation Script
# Author: Lululla
# License: CC BY-NC-SA 4.0

print_header() {
    echo "############################################################"
    echo "#                                                          #"
    echo "#  Vavoo Stream Live Plugin - Installation                 #"
    echo "#  Author: Lululla (https://github.com/Belfagor2005)       #"
    echo "#  License: CC BY-NC-SA 4.0                                #"
    echo "#                                                          #"
    echo "############################################################"
}

print_footer() {
    # preinst runs BEFORE the package's files are unpacked - postinst is
    # the script that runs after installation and prints the real
    # completion message. This used to claim "Installation Completed
    # Successfully" here too, which was misleading (and factually wrong,
    # since no plugin files exist on disk yet at this point).
    echo "############################################################"
    echo "#                                                          #"
    echo "#  Pre-installation checks completed                       #"
    echo "#                                                          #"
    echo "#  Proceeding with package installation...                 #"
    echo "#                                                          #"
    echo "############################################################"
}

# Check that opkg exists
command -v opkg >/dev/null 2>&1 || {
    echo "ERROR: opkg package manager not found."
    echo "This script requires an Enigma2-based system with opkg."
    exit 1
}

print_header

# Remove old version if found
echo "Checking for existing Vavoo installations..."
if [ -d "/usr/lib/enigma2/python/Plugins/Extensions/vavoo" ]; then
    # Older versions kept the favourites and the list of exported
    # bouquets in the plugin folder, deleted just below: keep them in
    # /etc/enigma2, where the plugin reads them now. Never over newer
    # ones already there.
    OLD="/usr/lib/enigma2/python/Plugins/Extensions/vavoo"
    if [ -f "$OLD/vavoo_favourites.json" ] && [ ! -f /etc/enigma2/vavoo_favourites.json ]; then
        cp -p "$OLD/vavoo_favourites.json" /etc/enigma2/vavoo_favourites.json && echo "✓ Favourites kept in /etc/enigma2"
    fi
    if [ -f "$OLD/Favorite.txt" ] && [ ! -f /etc/enigma2/vavoo_bouquet_list.txt ]; then
        cp -p "$OLD/Favorite.txt" /etc/enigma2/vavoo_bouquet_list.txt && echo "✓ Bouquet list kept in /etc/enigma2"
    fi
    echo "Removing previous version of Vavoo plugin..."
    rm -rf /usr/lib/enigma2/python/Plugins/Extensions/vavoo > /dev/null 2>&1
    echo "✓ Previous version removed successfully"
else
    echo "✓ No previous installation found"
fi

# The dependencies (python3-requests, python3-six, ffmpeg...) are in
# CONTROL/control's Depends: - opkg installs them itself. Running
# "opkg update" / "opkg install" from here, inside opkg's own run,
# only failed on its lock (or waited on the network).
if [ -e "/usr/bin/python3" ]; then
    echo "✓ Using Python 3"
else
    echo "⚠ /usr/bin/python3 not found, but continuing (required by package dependencies)"
fi

# Additional dependency checks
echo "Verifying system compatibility..."
if [ -e "/usr/bin/enigma2" ]; then
    echo "✓ Enigma2 detected"
else
    echo "⚠ Enigma2 not found in standard location"
fi

print_footer

exit 0